# Obligatorio: secreto de al menos 32 bytes para firmar los JWT.
# Generar un secreto aleatorio: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=invernadero-api
JWT_AUDIENCE=invernadero-clientes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Orígenes React autorizados, separados por comas y sin barra final.
WEB_ORIGINS=http://localhost:5173
# React permanece en localhost y consume la API HTTPS de Cloudflare.
# La cookie debe permitir solicitudes entre sitios y viajar solo por HTTPS.
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
PORT=3000


# Obligatorio: cadena PostgreSQL de Supabase, disponible en Connect.
DATABASE_URL=

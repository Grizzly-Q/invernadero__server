# Obligatorio: secreto de al menos 32 bytes para firmar los JWT.
# Generar un secreto aleatorio: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Obligatoria: clave AES-256 en Base64, distinta de JWT_SECRET.
# Generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
JWT_ISSUER=invernadero-api
JWT_AUDIENCE=invernadero-android
JWT_ACCESS_TTL_SECONDS=900
PORT=3000

# Opcional: configurar ambos valores para crear el administrador inicial.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Obligatorio: cadena PostgreSQL de Supabase, disponible en Connect.
DATABASE_URL=
